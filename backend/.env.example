NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_URL=redis://localhost:6379

# JWT — phải >= 32 ký tự ngẫu nhiên
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Cron jobs (mặc định: nhắc hạn mỗi ngày lúc 7:00 sáng)
CRON_REMINDER_SCHEDULE=0 7 * * *
# Số ngày trước hạn để gửi nhắc
REMINDER_DAYS_BEFORE=2
